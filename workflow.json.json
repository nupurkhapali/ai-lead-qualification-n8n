          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst form = $('On form submission').first().json;\n\nlet d = null, valid = true, error = '';\ntry {\n  d = JSON.parse(raw.replace(/```json|```/g, '').trim());\n} catch (e) {\n  valid = false;\n  error = 'Invalid JSON: ' + e.message;\n}\n\nif (valid && !['high', 'medium', 'low'].includes(d.priority)) { valid = false; error = 'Bad priority value'; }\nif (valid && !['buy', 'rent', 'invest', 'unknown'].includes(d.intent)) { valid = false; error = 'Bad intent value'; }\n\nlet score = 'Cold', points = 0;\nif (valid) {\n  let b = Number(d.budget_aed) || 0;\n  if (d.intent === 'rent') b = b * 10; // rough: yearly rent -> purchase-equivalent\n  if (b >= 2000000) points += 3; else if (b >= 800000) points += 2; else if (b > 0) points += 1;\n  points += { high: 3, medium: 2, low: 0 }[d.priority];\n  if (d.location) points += 1;\n  if (d.bedrooms !== null && d.bedrooms !== undefined) points += 1;\n  score = points >= 6 ? 'Hot' : points >= 4 ? 'Warm' : 'Cold';\n}\n\nreturn [{ json: {\n  valid, error, score, points,\n  timestamp: form.submittedAt || new Date().toISOString(),\n  name: d?.name ?? '', email: form.email || form.Email || '', phone: form.phone || form.Phone || '', message: form.Message,\n  location: d?.location ?? '', budget_aed: d?.budget_aed ?? '', budget_text: d?.budget_text ?? '',\n  bedrooms: d?.bedrooms ?? '', property_type: d?.property_type ?? '', intent: d?.intent ?? '',\n  priority: d?.priority ?? '', language: d?.language ?? '',\n  reason: d?.score_reason ?? '', summary: d?.summary ?? '',\n  status: 'New', raw_output: raw\n}}];"
      },
