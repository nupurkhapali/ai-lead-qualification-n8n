      "id": "bc8708c0-598e-44d7-bf1e-f13a7e488146",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        160,
        112
      ],
      "credentials": {
